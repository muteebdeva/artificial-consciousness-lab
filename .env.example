# Copy to .env and fill in. Never commit real keys.
# Provider credentials (all optional; mock provider works without any)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
# Research engine settings
ACL_DB_PATH=./data/acl.sqlite3
ACL_PROVIDER=mock
ACL_PROVIDER_MODEL=
ACL_LOG_LEVEL=INFO
ACL_SEED=0
